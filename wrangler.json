{
	"compatibility_date": "2025-10-08",
	"main": "src/server/index.ts",
	"name": "koryusagi",
	"migrations": [
		{
			"new_sqlite_classes": ["Chat"],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": ["Rooms"],
			"tag": "v2"
		},
		{
			"new_sqlite_classes": ["Accounts"],
			"tag": "v3"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"build": {
		"command": "esbuild src/client/index.tsx --bundle --splitting --format=esm --platform=browser --outdir=public/dist"
	},
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Chat",
				"name": "Chat"
			},
			{
				"class_name": "Rooms",
				"name": "Rooms"
			},
			{
				"class_name": "Accounts",
				"name": "Accounts"
			}
		]
	},
	"secrets": {
		"required": ["OWNER_ACCOUNT_IDS"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
